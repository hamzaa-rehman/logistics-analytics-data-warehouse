<mxCell id="bronze_foot_txt" value='&lt;b style="font-size:11px;color:#64748B;letter-spacing:0.4px;"&gt;LOADING · FULL REFRESH&lt;/b&gt;&lt;br&gt;&lt;b&gt;bronze.load_bronze&lt;/b&gt;&lt;br&gt;TRUNCATE → BULK INSERT, per table&lt;br&gt;No single wrapping transaction' style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=12;fontColor=#1E293B;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bronze"><mxGeometry x="24" y="264" width="252" height="82" as="geometry"/></mxCell>
