<mxCell id="bronze_items" value='&lt;ul style="margin:0;padding-left:16px;"&gt;&lt;li style="margin-bottom:4px;"&gt;All columns stored as VARCHAR&lt;/li&gt;&lt;li style="margin-bottom:4px;"&gt;Raw source values preserved&lt;/li&gt;&lt;li style="margin-bottom:4px;"&gt;No cleaning, typing or business rules&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=13;fontColor=#1E293B;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bronze"><mxGeometry x="14" y="112" width="272" height="134" as="geometry"/></mxCell>
