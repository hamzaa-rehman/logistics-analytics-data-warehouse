<mxCell id="silver_items" value='&lt;ul style="margin:0;padding-left:16px;"&gt;&lt;li style="margin-bottom:4px;"&gt;Explicit data-type conversion (CONVERT)&lt;/li&gt;&lt;li style="margin-bottom:4px;"&gt;TRIM and blank values → NULL&lt;/li&gt;&lt;li style="margin-bottom:4px;"&gt;Approved column mappings, e.g. utilization_rate → trips_per_day&lt;/li&gt;&lt;li style="margin-bottom:4px;"&gt;Source grain preserved; no deduplication&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=13;fontColor=#1E293B;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="silver"><mxGeometry x="14" y="112" width="302" height="134" as="geometry"/></mxCell>
